EDIT_PASSWORD=pitzerfund
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT="Pitzer Investment Fund research@yourclubdomain.edu"
AUTO_REFRESH_PRICES=false
# Optional: turns on every AI feature (filing briefs, 10-K change briefs, news scoring, the Today
# recap). Default model gpt-6-luna; override with OPENAI_MODEL, or OPENAI_RECAP_MODEL /
# OPENAI_RECAP_EFFORT for the recap only.
OPENAI_API_KEY=
# Optional: research agents' model tiers (lib/agents/runs.js). Defaults: cheap = OPENAI_MODEL or
# gpt-6-luna, mid = gpt-6.1-sol, top = gpt-6-astra. A model must have a price in
# lib/sources/openai.js PRICES or runs refuse it (so the AI spending cap can count it).
AGENT_MODEL_CHEAP=
AGENT_MODEL_MID=
AGENT_MODEL_TOP=
# Optional: timeout in milliseconds for one OpenAI call (default 180000). Calls that time
# out, hit a rate limit or a 5xx are retried up to 4 times with backoff.
OPENAI_TIMEOUT_MS=
# Optional: research agents' web search (OpenAI's built-in tool, ~$0.01 per search, counted in
# the AI spending cap). On by default; AGENT_WEB_SEARCH=off turns it off.
AGENT_WEB_SEARCH=
WEB_SEARCH_COST_USD=
# Optional: earnings call transcripts for agents (Financial Modeling Prep). Without it agents
# read the earnings press release from the company's 8-K instead.
FMP_API_KEY=
# Optional: higher rate limits for lobbying (lda.gov) and FDA (openFDA) lookups. Both work without.
LDA_API_KEY=
OPENFDA_API_KEY=
