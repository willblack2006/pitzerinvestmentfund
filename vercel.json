{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm install && npm install --no-save --force @libsql/linux-x64-gnu@0.5.29 @libsql/linux-arm64-gnu@0.5.29",
  "functions": {
    "server.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "30 21 * * 1-5"
    }
  ]
}
